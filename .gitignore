# intermediários da geração do mapa (fonte e método documentados no README)
# padrão com "*" (e não "assets/") porque o git não desce em diretório ignorado —
# sem isso as exceções abaixo não funcionariam
assets/*

# ...exceto a capa do link (og:image), que É publicada junto com o site
!assets/og-image.png
!assets/og-image.html

# lixo de editor/SO
.DS_Store
Thumbs.db
*.log
node_modules/
